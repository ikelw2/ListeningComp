@page "/passages/{SessionId}"
@using SharedDtoClassLibrary.DTOs
@using System.Net.Http.Json
@using System.Text.Json
@implements IDisposable

@inject FrontEnd_BlazorWebAssemblyApp.Services.IPassageService PassageService
@inject NavigationManager Nav

@inject HttpClient Http


<PageTitle>Listening Comprehension</PageTitle>

@if (_loading)
{
    <p role="status">Loading listening session…</p>
}
else if (_error is not null)
{
    <p role="alert">@_error</p>
    <button type="button" @onclick="LoadContentAsync">Retry</button>
}
else if (_session is { } session)
{
    
    @* @if (_mediaUrl is not null)
    {
        <section id="s_media" aria-label="Audio">
            <audio @key="_mediaUrl" controls preload="metadata" src="@_mediaUrl">
            <audio controls>
                <source src="@_mediaUrl" type="audio/mpeg">
                Your browser does not support audio playback.
            </audio>
        </section>
    } *@
    
    <section id="s_transcript" aria-label="Transcript and translation">
        @for (var index = 0; index < session.Transcription.Count; index++)
        {
            <div class="listening-row">
                <div class="listening-col">@session.Transcription[index]</div>
                <div class="listening-col">@session.Translation[index]</div>
            </div>
        }
    </section>

    @if (_sourceUrl is not null)
    {
        <details id="s_source">
            <summary>Source information</summary>
            <p><a href="@_sourceUrl" target="_blank" rel="noopener noreferrer">@session.SourceUrl</a></p>
        </details>
    }

    <section aria-label="Questions">
        @for (var questionIndex = 0; questionIndex < session.Questions.Count; questionIndex++)
        {
            // Capture loop variables for callbacks.
            var q = questionIndex;
            var question = session.Questions[q];
            <fieldset id="@($"questionBlock_{q}")">
                <legend>@(q + 1). @question.QuestionText</legend>
                @for (var answerIndex = 0; answerIndex < question.AnswerChoices.Count; answerIndex++)
                {
                    var a = answerIndex;
                    var id = $"radioButton_{q}_{a}";
                    <div class="listening-choice">
                        <input type="radio" id="@id" name="@($"radioButtonGroup_{q}")"
                               value="@a" checked="@(_selectedAnswers[q] == a)"
                               @onchange="() => SelectAnswer(q, a)" />
                        <label for="@id">@question.AnswerChoices[a]</label>
                    </div>
                }
            </fieldset>
        }
    </section>

    @* @if (!string.IsNullOrEmpty(_mediaUrl))
    {
        <section id="s_media" aria-label="Audio">
            <audio controls>
                <source src="@_mediaUrl" type="audio/mpeg" />
                Your browser does not support audio playback.
            </audio>
        </section>
    }
    else
    {
        <p>Loading audio player...</p>
    } *@
    <p>skipping audio player...</p>
}




@code {

    [Parameter] public string SessionId { get; set; } = string.Empty;

    private ListeningDto? _session;
    private int?[] _selectedAnswers = Array.Empty<int?>();
    private bool _loading;
    private string? _error;
    private string? _sourceUrl;
    private string? _mediaUrl;
    private string? _mediaUrlRelative;
    private CancellationTokenSource? _request;
    private bool _disposed;

    protected override Task OnParametersSetAsync() => LoadContentAsync();

    private async Task LoadContentAsync()
    {
        _request?.Cancel();
        using var request = new CancellationTokenSource();
        _request = request;
        _loading = true;
        _error = null;
        _session = null;
        _sourceUrl = null;
        _mediaUrl = null;
        _selectedAnswers = Array.Empty<int?>();

        try
        {
            // Replace this path with your actual API endpoint.
            var session = await Http.GetFromJsonAsync<ListeningDto>(
                $"api/passages/{SessionId}", request.Token);

            if (_disposed || request.IsCancellationRequested) return;

            _error = Validate(session);
            if (_error is not null) return;

            _sourceUrl = ResolveUrl(session!.SourceUrl);
            _mediaUrlRelative = ResolveUrl(session.MediaUrl);
            // Combine it into: "https://localhost:7001/media/song.mp3"
            //_mediaUrl _mediaUrl = $"https://landnavapp.com/l/sessions/{_mediaUrlRelative.TrimStart('/')}";
            //_mediaUrl = $"https://localhost:7009/api/media/{_mediaUrlRelative.TrimStart('/')}";            
            _mediaUrl = $"/media{_mediaUrlRelative.TrimStart('/')}";
            Console.WriteLine("   *** mediaurl is " + _mediaUrl);

            _session = session;
            _selectedAnswers = new int?[session.Questions.Count];
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested)
        {
            // A newer load or navigation away canceled this request.
        }
        catch (OperationCanceledException)
        {
            _error = "The API request timed out. Please retry.";
        }
        catch (HttpRequestException)
        {
            _error = "Unable to load this listening session. Please retry.";
        }
        catch (JsonException)
        {
            _error = "The API returned invalid listening session JSON.";
        }
        catch (InvalidDataException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            if (ReferenceEquals(_request, request))
            {
                _request = null;
                _loading = false;
            }
        }
    }



    
    private static string? Validate(ListeningDto? session)
    {
        if (session is null) return "The API returned no listening session.";

        // JSON can explicitly contain null despite the DTO's default initializers.
        if (session.Transcription is null || session.Translation is null ||
            session.Transcription.Count == 0 ||
            session.Transcription.Count != session.Translation.Count)
            return "Transcript and translation must contain the same nonzero number of paragraphs.";

        if (session.Questions is null) return "The API returned an invalid questions list.";

        for (var i = 0; i < session.Questions.Count; i++)
        {
            var question = session.Questions[i];
            if (question is null || string.IsNullOrWhiteSpace(question.QuestionText) ||
                question.AnswerChoices is null || question.AnswerChoices.Count < 2 ||
                question.AnswerChoices.Any(string.IsNullOrWhiteSpace))
                return $"Question {i + 1} must have question text and at least two nonempty choices.";
        }

        return null;
    }

    private string? ResolveUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;

        Uri? url;
        if (!Uri.TryCreate(value, UriKind.Absolute, out url))
        {
            if (Http.BaseAddress is null || !Uri.TryCreate(Http.BaseAddress, value, out url))
                throw new InvalidDataException("The API returned an invalid source or media URL.");
        }

        if (url.Scheme != Uri.UriSchemeHttp && url.Scheme != Uri.UriSchemeHttps)
            throw new InvalidDataException("Source and media URLs must use HTTP or HTTPS.");

        return url.AbsoluteUri;
    }

    private void SelectAnswer(int questionIndex, int answerIndex)
        => _selectedAnswers[questionIndex] = answerIndex;

    public void Dispose()
    {
        _disposed = true;
        _request?.Cancel();
        _request?.Dispose();
        _request = null;
    }

}




