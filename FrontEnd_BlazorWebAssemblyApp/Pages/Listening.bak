	<p id="s_admin">&nbsp;<button onclick="ExpandDetail('s_media')" id="mediaButton"><b>&#9835;</b></button> <button onclick="ExpandDetail('s_questions')" id="questionButton"><b>?</b></button> <button onclick="shareQs()" id="shareQsButton"><span style="font-size: .875em; margin-right: .125em; position: relative; top: -.25em; left: -.125em">📄<span style="position: absolute; top: .25em; left: .25em">📄</span></span></button> </p>
