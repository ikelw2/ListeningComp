@page "/passages/{Id}"
@page "/passage/{Id}"
@code {
    // color variables for this page (can be adjusted or replaced by CSS variables)
    private readonly string _colorPrimary = "#FAFAFA"; // background (light mode)
    private readonly string _colorSecondary = "#121212"; // text (light mode)
    private readonly string _colorTertiary = "#BDBDBD"; // translation (light mode)
}
@using SharedDtoClassLibrary.DTOs
@using System.Text.Json
@using System.Text.RegularExpressions
@using System.Net
@inject HttpClient Http
@inject NavigationManager Nav

@if (_loading)
{
    <p>Loading passage…</p>
}
else if (!string.IsNullOrEmpty(_error))
{
    <p class="text-danger">Error: @_error</p>
}
else if (_session is not null)
{
    @* Music toggle and questions toggle buttons placed before the media (same line) *@
    <div style="margin-top:0.5rem; margin-bottom:0.5rem; display:flex; gap:0.5rem; align-items:center;">
        <button class="btn btn-music" @onclick="ToggleMedia">&#9835;</button>
        <button class="btn btn-questions" @onclick="ToggleQuestions">?</button>
    </div>

    @* Audio player (near top) *@
    @if (!string.IsNullOrEmpty(_mediaSrc) && _showMedia)
    {
        <section aria-label="Audio" style="margin-bottom:1rem;" class="section-gutter media-gutter">
            <audio controls preload="metadata" src="@_mediaSrc">
                Your browser does not support the audio element.
            </audio>
        </section>
    }

    @* Questions with radio options (can be toggled) *@
    @if (_showQuestions)
    {
        <section aria-label="Questions" class="section-gutter">
            @for (var questionIndex = 0; questionIndex < _session.Questions.Count; questionIndex++)
            {
                var q = questionIndex;
                var question = _session.Questions[q];
                <fieldset class="no-border">
                    <legend>@(q + 1). @question.QuestionText</legend>
                    @for (var answerIndex = 0; answerIndex < question.AnswerChoices.Count; answerIndex++)
                    {
                        var a = answerIndex;
                        var id = $"radio_{q}_{a}";
                        <div style="margin:4px 0;">
                            <input type="radio" id="@id" name="@($"q_{q}")" value="@a"
                                    checked="@(_selectedAnswers.Length > q && _selectedAnswers[q] == a)"
                                    @onchange="() => SelectAnswer(q, a)"
                                    disabled="@_showCorrectAnswers" />
                            <label for="@id" style="text-decoration:@((_showCorrectAnswers && _correctChoicesByPosition != null && _correctChoicesByPosition.Length > q && _correctChoicesByPosition[q] == a) ? "underline" : "none")">@question.AnswerChoices[a]</label>
                        </div>
                    }
                </fieldset>
            }

            @* Controls row: Text toggle and Answers button at bottom of questions; score text inline *@
            <div style="margin-top:0.5rem; margin-bottom:0.5rem; display:flex; align-items:center; gap:0.5rem;">
                <button class="btn btn-text" @onclick="ToggleText">&#9776;</button>
                <button class="btn btn-secondary" @onclick="ToggleAnswersAsync" style="background-color:var(--answer-color); color:#ffffff; border-color:transparent;">&#10004;</button>
                @if (!string.IsNullOrEmpty(_scoreText))
                {
                    <span>@_scoreText (@("reload page to clear this message"))</span>
                }
            </div>
        </section>
    }

    @if (_showText)
    {
        <section id="textSection" style="margin-top:0.5rem;" class="section-gutter text-gutter">
            @* Transcription / Translation two-column table *@
            <div style="overflow:auto;">
                <table style="width:95%; border-collapse:collapse; margin-bottom:1rem;">
                    @for (var i = 0; i < _session.Transcription.Count; i++)
                    {
                        <tr class="trans-row">
                            <td style="width:50%; padding:8px; vertical-align:top;">@StripHtml(_session.Transcription[i])</td>
                            <td class="translation" style="width:50%; padding:8px; vertical-align:top;">@StripHtml(_session.Translation[i])</td>
                        </tr>
                    }
                </table>
            </div>

            @* Source toggle (button only) inside the transcript/translation section at the very bottom *@
            <div style="margin-top:1rem; margin-bottom:0.5rem; display:flex; gap:0.75rem; align-items:center;">
                <button class="btn btn-secondary" @onclick="ToggleSource" style="background-color:#C0C0C0; color:#000000; border-color:transparent;">&#9888;</button>
            </div>
        </section>
    }
    @* Source link placed immediately beneath the transcription/translation section (outside of it) *@
    @if (_showSource)
    {
        <div style="margin-top:0.5rem; margin-bottom:0.5rem;" class="section-gutter source-gutter">
            <p><a href="@_session.SourceUrl" target="_blank" rel="noopener noreferrer">@_session.SourceUrl</a></p>
        </div>
    }
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private ListeningDto? _session;
    private bool _loading;
    private string? _error;
    private string? _mediaSrc;
    private int?[] _selectedAnswers = Array.Empty<int?>();
    private bool _showText;
    private bool _showSource;
    private bool _showMedia = false; // media hidden by default
    private bool _showQuestions = false; // questions hidden by default
    private bool _showCorrectAnswers;
    private int[]? _correctChoicesByPosition;
    private string? _scoreText;
    [CascadingParameter] FrontEnd_BlazorWebAssemblyApp.Shared.PageState? PageState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _session = null;
        _mediaSrc = null;

        try
        {
            var resp = await Http.GetAsync($"api/passages/{Id}");
            var text = await resp.Content.ReadAsStringAsync();

            if (!resp.IsSuccessStatusCode)
            {
                _error = $"API returned {(int)resp.StatusCode}: {resp.ReasonPhrase}";
                Console.WriteLine("RAW RESPONSE BODY: " + text);
                return;
            }

            var opts = new JsonSerializerOptions { PropertyNameCaseInsensitive = true }; // required to prevent JSON load error
            try
            {
                _session = JsonSerializer.Deserialize<ListeningDto>(text, opts);
            }
            catch (JsonException jex)
            {
                _error = "Json error: " + jex.Message;
                Console.WriteLine("JSON EXCEPTION: " + jex);
                Console.WriteLine("RAW RESPONSE BODY: " + text);
                return;
            }

            if (_session is null)
            {
                _error = "API returned no listening session.";
                return;
            }

            // update page title in layout via PageState cascading parameter
            if (PageState is not null)
            {
                PageState.Title = $"Passage {_session.Title}";
            }

            // initialize selected answers array
            _selectedAnswers = new int?[ _session.Questions.Count ];

            // Resolve media source: if absolute http(s) use as-is, otherwise assume it's served from client wwwroot/media
            var media = _session.MediaUrl ?? string.Empty;
            if (!string.IsNullOrWhiteSpace(media))
            {
                if (Uri.TryCreate(media, UriKind.Absolute, out var m) && (m.Scheme == Uri.UriSchemeHttp || m.Scheme == Uri.UriSchemeHttps))
                {
                    _mediaSrc = media;
                }
                else
                {
                    // ensure it points to /media/...
                    var trimmed = media.TrimStart('/');
                    if (!trimmed.StartsWith("media/", StringComparison.OrdinalIgnoreCase))
                        trimmed = "media/" + trimmed;

                    // use relative URL so the browser requests it from the Blazor host
                    _mediaSrc = "/" + trimmed;
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectAnswer(int questionIndex, int answerIndex)
    {
        if (_selectedAnswers.Length <= questionIndex) return;
        _selectedAnswers[questionIndex] = answerIndex;
    }

    private void ToggleText()
    {
        _showText = !_showText;
    }

    private void ToggleSource()
    {
        _showSource = !_showSource;
    }

    private void ToggleQuestions()
    {
        _showQuestions = !_showQuestions;
    }

    private void ToggleMedia()
    {
        _showMedia = !_showMedia;
    }

    private async Task ToggleAnswersAsync()
    {
        // If we haven't fetched grading info yet, fetch it
        if (_correctChoicesByPosition == null)
        {
            try
            {
                var grading = await Http.GetFromJsonAsync<GradingDto>($"api/passages/{Id}/grading");
                if (grading != null)
                {
                    // build array indexed by Position
                    var maxPos = grading.Questions.Any() ? grading.Questions.Max(q => q.Position) : -1;
                    var size = Math.Max(maxPos + 1, _session?.Questions.Count ?? 0);
                    _correctChoicesByPosition = new int[size];
                    foreach (var q in grading.Questions)
                    {
                        if (q.Position >= 0 && q.Position < size)
                            _correctChoicesByPosition[q.Position] = q.CorrectChoice;
                    }

                    // compute score based on current selections
                    var total = grading.Questions.Count;
                    var correct = 0;
                    for (int i = 0; i < total; i++)
                    {
                        var user = (_selectedAnswers.Length > i) ? _selectedAnswers[i] : null;
                        var correctChoice = (i < _correctChoicesByPosition.Length) ? _correctChoicesByPosition[i] : -1;
                        if (user.HasValue && user.Value == correctChoice) correct++;
                    }

                    _scoreText = $"You scored {correct} out of {total}";
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("Failed to fetch grading info: " + ex.Message);
                _scoreText = "Unable to fetch answers";
            }
        }

        // Toggle underline display; score text remains
        _showCorrectAnswers = !_showCorrectAnswers;
    }

    private static string StripHtml(string? input)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;

        // Remove tags
        var noTags = Regex.Replace(input, "<.*?>", string.Empty);

        // Decode any HTML entities (e.g., &amp; -> &)
        return WebUtility.HtmlDecode(noTags);
    }
}
