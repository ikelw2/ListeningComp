@using SharedDtoClassLibrary.DTOs
@inject FrontEnd_BlazorWebAssemblyApp.Services.IPassageService PassageService
@inject NavigationManager Nav
@using FrontEnd_BlazorWebAssemblyApp.Shared

@page "/"

<PageTitle>Listening Comprehension</PageTitle>




<h1>Select a passage</h1>

<ul>
    @if (titles == null)
    {
        <li>
            Loading...
        </li>
    }
    else
    {
        @foreach (var t in titles)
        {
            <li>
                <button @onclick="@(() => NavigateToPassage(t.Id, t.Title))">
                    @t.Title
                </button>
            </li>
        }
    }
</ul>




@code 
{
    private List<TitleListDto>? titles;
    [CascadingParameter] FrontEnd_BlazorWebAssemblyApp.Shared.PageState? PageState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        titles = await PassageService.GetTitleListAsync();
    }

    private void NavigateToPassage(string id, string title)
    {
        // set the shared PageState title so layout shows it before navigation completes
        if (PageState is not null)
        {
            PageState.Title = $"Passage {title}";
        }

        Nav.NavigateTo($"/passages/{id}");
    }
}